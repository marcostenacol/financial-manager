generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model Role {
  id    String @id @default(uuid())
  name  String
  slug  String @unique  // admin, user

  users User[]

  @@map("roles")
}

model UserStatus {
  id   String @id @default(uuid())
  name String
  slug String @unique  // active, inactive, banned

  userHasStatuses UserHasStatus[]
  User            User[]          @relation("LastStatus")

  @@map("user_statuses")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String
  roleId       String  @map("role_id")
  lastStatusId String? @map("last_status_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
 
   role            Role            @relation(fields: [roleId], references: [id])
   lastStatus      UserStatus?     @relation("LastStatus", fields: [lastStatusId], references: [id])
   statusHistory   UserHasStatus[]
   refreshTokens   RefreshToken[]
   profile         Profile?
   wallets         Wallet[]
   savingsGoals    SavingsGoal[]
   notifications   Notification[]
   costCenters     CostCenter[]
   organizationMemberships OrganizationMember[]
   invitesCreated  Invite[]
   inviteRedemptions InviteRedemption[]
   people          Person[]

   @@map("users")
 }

model UserHasStatus {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  statusId  String  @map("status_id")
  reason    String?
  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  user   User       @relation(fields: [userId], references: [id])
  status UserStatus @relation(fields: [statusId], references: [id])

  @@map("user_has_statuses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// SOCIAL
// ─────────────────────────────────────────

model Profile {
  id     String  @id @default(uuid())
  userId String  @unique @map("user_id")
  name   String
  avatar String?
  bio    String?
  type   String  // personal, business

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("profiles")
}

// ─────────────────────────────────────────
// ORGANIZATIONS (tenant opcional — uso empresarial multi-usuário)
// ─────────────────────────────────────────

enum OrganizationMemberRole {
  owner
  member
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members      OrganizationMember[]
  wallets      Wallet[]
  categories   Category[]
  costCenters  CostCenter[]
  savingsGoals SavingsGoal[]
  invites      Invite[]
  people       Person[]

  @@map("organizations")
}

model OrganizationMember {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  userId         String                 @map("user_id")
  role           OrganizationMemberRole @default(member)

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Invite {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  code           String                 @unique
  role           OrganizationMemberRole @default(member)
  maxUses        Int?                   @map("max_uses") // null = uso único
  usesCount      Int                    @default(0) @map("uses_count")
  expiresAt      DateTime               @map("expires_at")
  revokedAt      DateTime?              @map("revoked_at")
  createdBy      String                 @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  creator      User               @relation(fields: [createdBy], references: [id])
  redemptions  InviteRedemption[]

  @@map("invites")
}

model InviteRedemption {
  id       String   @id @default(uuid())
  inviteId String   @map("invite_id")
  userId   String   @map("user_id")
  usedAt   DateTime @default(now()) @map("used_at")

  invite Invite @relation(fields: [inviteId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([inviteId, userId])
  @@map("invite_redemptions")
}

// ─────────────────────────────────────────
// FINANCIAL
// ─────────────────────────────────────────

enum ProfileScope {
  personal
  business
}

model Wallet {
  id             String  @id @default(uuid())
  userId         String? @map("user_id")
  organizationId String? @map("organization_id")
  name           String
  type           String  // checking, savings, credit, investment, cash
  scope          ProfileScope @default(personal)
  balance        Decimal @default(0) @db.Decimal(15, 2)
  currency       String  @default("BRL")
  isPrimary      Boolean @default(false) @map("is_primary")
  deletedAt      DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  transactions Transaction[]
  recurrences  Recurrence[]

  @@map("wallets")
}

model Category {
  id             String  @id @default(uuid())
  userId         String? @map("user_id")  // null = categoria do sistema (se organizationId também null)
  organizationId String? @map("organization_id")
  name           String
  color          String
  icon           String?
  type           String  // income, expense, both
  scope          ProfileScope? // null = global, visível nos dois escopos

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  transactions Transaction[]
  recurrences  Recurrence[]

  @@map("categories")
}

model CostCenter {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  organizationId String?  @map("organization_id")
  name           String
  color          String   @default("#3b82f6")

  createdAt DateTime @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  transactions Transaction[]

  @@map("cost_centers")
}

model Transaction {
  id           String   @id @default(uuid())
  walletId     String   @map("wallet_id")
  categoryId   String   @map("category_id")
  recurrenceId String?  @map("recurrence_id")
  costCenterId String?  @map("cost_center_id")
  personId     String?  @map("person_id")
  type         String   // income, expense, transfer
  amount       Decimal  @db.Decimal(15, 2)
  description  String?
  status       String   // pending, completed, cancelled
  occurredAt   DateTime @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wallet     Wallet      @relation(fields: [walletId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  recurrence Recurrence? @relation(fields: [recurrenceId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  person     Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model Recurrence {
  id              String    @id @default(uuid())
  walletId        String    @map("wallet_id")
  categoryId      String    @map("category_id")
  type            String    // income, expense
  amount          Decimal   @db.Decimal(15, 2)
  description     String?
  period          String    // daily, weekly, monthly, yearly
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  lastProcessedAt DateTime? @map("last_processed_at")
  isActive        Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  wallet       Wallet        @relation(fields: [walletId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
 
   @@map("recurrences")
 }
 
 model SavingsGoal {
   id             String    @id @default(uuid())
   userId         String?   @map("user_id")
   organizationId String?   @map("organization_id")
   name           String
   targetAmount Decimal   @map("target_amount") @db.Decimal(15, 2)
   currentAmount Decimal  @default(0) @map("current_amount") @db.Decimal(15, 2)
   deadline     DateTime?
   color        String    @default("#3b82f6")
   icon         String?

   createdAt DateTime @default(now()) @map("created_at")
   updatedAt DateTime @updatedAt @map("updated_at")

   user         User?         @relation(fields: [userId], references: [id])
   organization Organization? @relation(fields: [organizationId], references: [id])

   @@map("savings_goals")
 }

model Notification {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  title   String
  message String
  type    String  @default("info")
  read    Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─────────────────────────────────────────
// PEOPLE (pessoas a quem se deve — área isolada, sem vínculo com carteiras)
// ─────────────────────────────────────────

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

// ONE_TIME: dívida avulsa, "pago" é um estado final (isPaid).
// MONTHLY: obrigação recorrente (ex.: aluguel) — "pago" vale só para o mês
// corrente (lastPaidPeriod, formato "YYYY-MM"); vira pendente de novo a cada
// novo mês sem precisar de job/reset — a leitura só compara com o mês atual.
enum PaymentFrequency {
  ONE_TIME
  MONTHLY
}

model Person {
  id               String           @id @default(uuid())
  userId           String?          @map("user_id")
  organizationId   String?          @map("organization_id")
  scope            ProfileScope     @default(personal)
  name             String
  theyOweMe        Decimal          @default(0) @map("they_owe_me") @db.Decimal(15, 2)
  iOweThem         Decimal          @default(0) @map("i_owe_them") @db.Decimal(15, 2)
  paymentFrequency PaymentFrequency @default(ONE_TIME) @map("payment_frequency")
  isPaid           Boolean          @default(false) @map("is_paid")
  lastPaidPeriod   String?          @map("last_paid_period")
  pixKey           String           @map("pix_key")
  pixKeyType       PixKeyType       @map("pix_key_type")
  pixCity          String?          @map("pix_city")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  transactions Transaction[]

  @@map("people")
}
